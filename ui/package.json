{
  "name": "@degeneffe/tcms-ui",
  "version": "0.1.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/degeneffe/tcms-packages.git",
    "directory": "ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "//": "react and react-dom stay OPTIONAL peers for the components that will land later. react-native is deliberately absent: this package exports plain token objects and renders nothing native, so declaring RN only made consumers install the whole 0.74 toolchain (#2).",
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
